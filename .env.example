# Copie para .env (local) ou cadastre como variáveis no Railway.

# Onde este processo roda:
#   nuvem → o sistema (painel, cadastro, Telegram) — Railway
#   local → agente da escola (só a catraca + cópia local do cadastro)
#   unico → tudo numa máquina só (desenvolvimento, ou escola sem nuvem)
MODO=unico

# PostgreSQL (Railway injeta DATABASE_URL automaticamente no serviço ligado ao banco)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexosix

# Chave da sessão Flask — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Primeiro acesso (nuvem/unico): cria o superadmin se a tabela usuarios_admin estiver vazia
ADMIN_EMAIL=bruno@nexosix.com.br
ADMIN_SENHA=troque-esta-senha

# Token da catraca no Monitor/modo online quando a escola não tem token próprio (MODO=unico
# ou agente). Na nuvem só vale o token de cada escola (unidades.config.monitor_token).
MONITOR_TOKEN=troque-este-token

# URL pública deste processo. Nuvem: a URL do Railway. Agente: http://<IP fixo do PC>:8000
# (é pra esse endereço que a catraca manda Monitor e pergunta no modo Pro).
BASE_URL=http://localhost:5000

# Telegram (BotFather) — só na nuvem/unico. TELEGRAM_WEBHOOK_SECRET protege /api/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Convite aos responsáveis por e-mail — só na nuvem (web e worker). Um dos dois provedores
# (Brevo grátis: 300/dia) + remetente verificado no provedor. Railway bloqueia SMTP: é por API.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_REMETENTE=

# ---- Agente (MODO=local) ----
# id da unidade na nuvem, URL da nuvem e o token gerado lá (flask --app wsgi token-espelho --unidade-id N)
UNIDADE_ID=1
NUVEM_URL=https://nexosix-acesso.up.railway.app
ESPELHO_TOKEN=
# Porta em que a catraca liga no agente. Com redundância por DNS use 80 (a nuvem também
# atende em 80 via Cloudflare), e BASE_URL=http://catraca-recreio.nexosix.com.br
PORT=80

# ---- Redundância (só na nuvem) ----
# Vigia: agente mudo por FAILOVER_APOS_SEG → o nome DNS da catraca (config da unidade) passa a
# apontar pra nuvem (CNAME FAILOVER_NUVEM_ALVO, proxied na Cloudflare); agente volta → A <ip da LAN>
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
FAILOVER_NUVEM_ALVO=nexosix-acesso.up.railway.app
# Domínio dos nomes das catracas (catraca-u<id>.<domínio>); o vigia nunca aponta nome fora dele
FAILOVER_DOMINIO=
FAILOVER_APOS_SEG=120
# Só devolve a catraca pro agente depois de tantos segundos estável (evita o DNS pular)
FAILOVER_VOLTA_SEG=120

# Alertas para a Nexosix (agente mudo, catraca fora, Telegram falhando): chat no bot.
# Para saber o número: mande /meuid para o bot.
ALERTA_TELEGRAM_CHAT=
# Cópia semanal do banco, criptografada, mandada pelo bot (worker da nuvem). Sem a senha o
# arquivo não abre — guarde-a fora do Railway (gerenciador de senhas). Chat: padrão = o dos alertas.
BACKUP_SENHA=
BACKUP_TELEGRAM_CHAT=

# Worker
WORKER_INTERVALO_SEG=5
WORKER_COLETA_SEG=30
# 1 = adaptadores "controlid" falam com o simulador em vez de hardware (dev/testes)
CONTROLID_SIMULADOR=0

# Fuso padrão de exibição
TZ_PADRAO=America/Sao_Paulo
