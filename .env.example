# Copie para .env (local) ou cadastre como variáveis no Railway.

# PostgreSQL (Railway injeta DATABASE_URL automaticamente no serviço ligado ao banco)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexosix

# Chave da sessão Flask — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Primeiro acesso: cria o superadmin se a tabela usuarios_admin estiver vazia
ADMIN_EMAIL=bruno@nexosix.com.br
ADMIN_SENHA=troque-esta-senha

# Token que a catraca manda nas notificações do Monitor (segredo compartilhado, vai na URL
# configurada na catraca: monitor.path = api/notifications/<MONITOR_TOKEN>)
MONITOR_TOKEN=troque-este-token

# Telegram (BotFather). TELEGRAM_WEBHOOK_SECRET protege o endpoint /api/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# URL pública do web (Railway gera). Usada pra montar links/QR e pra registrar o webhook.
BASE_URL=http://localhost:5000

# Worker
WORKER_INTERVALO_SEG=5
# 1 = adaptadores "controlid" falam com o simulador em vez de hardware (dev/testes)
CONTROLID_SIMULADOR=0

# Fuso padrão de exibição
TZ_PADRAO=America/Sao_Paulo

# ---- Modelo 3 (servidor local na escola + nuvem como espelho) ----
# local = servidor da escola (decide, grava, fala com a catraca, manda Telegram, espelha pra nuvem)
# nuvem = painel consolidado da rede, somente leitura, recebe o espelho
MODO=local
# Só no servidor local: para onde enviar o espelho e o token gerado na nuvem
# (na nuvem: flask --app wsgi token-espelho --unidade-id N)
NUVEM_URL=https://nexosix-acesso.up.railway.app
ESPELHO_TOKEN=
ESPELHO_INTERVALO_SEG=15
