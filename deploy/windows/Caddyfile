# HTTPS na rede da escola. O navegador só libera a webcam (getUserMedia) em https:// ou
# localhost; com Caddy os PCs da secretaria acessam https://nexosix.local.
# Nos PCs clientes: adicionar "<IP do servidor> nexosix.local" em
# C:\Windows\System32\drivers\etc\hosts e rodar "caddy trust" (ou aceitar o aviso de certificado).
{
    auto_https disable_redirects
}

https://nexosix.local {
    tls internal
    reverse_proxy 127.0.0.1:8000
}

# A catraca fala HTTP puro com o Monitor; mantemos a porta 8000 aberta pra ela.
